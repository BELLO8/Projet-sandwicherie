# DB_HOST=localhost
# DB_NAME=resto
# DB_USER=root
# DB_PASSWORD=
# WEB_PORT=8080

# # Configuration de l'application
# APP_NAME=Sandwicherie
# APP_ENV=development
# APP_DEBUG=true
# APP_URL=http://localhost 


# ===========================
# 🌐 Configuration de l'application
# ===========================
APP_NAME=Sandwicherie
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:${WEB_PORT}

# ===========================
# 🗄️ Base de données MySQL
# ===========================
DB_CONNECTION=mysql
DB_HOST=db                # ✅ utiliser le nom du service Docker
DB_PORT=3306
DB_DATABASE=resto
DB_USERNAME=root
DB_PASSWORD=

# ===========================
# 🧩 Configuration Docker
# ===========================
WEB_PORT=8080
PHPMYADMIN_PORT=8081

# ===========================
# 🧠 MySQL (pour docker-compose)
# ===========================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=resto
MYSQL_USER=root
MYSQL_PASSWORD=

# ===========================
# 📬 (Optionnel) Mailpit / SMTP
# ===========================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@sandwicherie.test
MAIL_FROM_NAME="${APP_NAME}"

# ===========================
# 🗃️ (Optionnel) Cache & Session
# ===========================
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
